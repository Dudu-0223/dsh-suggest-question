{
  "name": "@dudu-0223/dsh-suggest-question",
  "version": "1.0.0",
  "type": "module",
  "description": "Guesses your next message after a turn ends and shows it as a light ghost line in the composer; Tab fills it.",
  "author": "Dudu-0223",
  "homepage": "https://github.com/Dudu-0223/dsh-suggest-question",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dudu-0223/dsh-suggest-question.git",
    "directory": "plugin"
  },
  "keywords": [
    "composer",
    "suggestion",
    "ghost-text",
    "llm",
    "next-message"
  ],
  "engines": {
    "dsh": ">=0.2.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "MIT"
}
